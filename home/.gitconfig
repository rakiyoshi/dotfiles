[user]
	name = Ryoh Akiyoshi
	email = ryo614@gmail.com
[core]
	excludesfile = ~/.config/git/ignore
	editor = /usr/bin/env nvim
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[init]
	defaultBranch = main
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = false
[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"
[alias]
	merged-branches = "!f() { \
		git for-each-ref \
			--format='%(refname:short)' \
			refs/heads | \
		while IFS= read -r branch; do \
			case \"$branch\" in \
				main|master|develop) continue ;; \
			esac; \
			if gh pr list \
				--head \"$branch\" \
				--state merged \
				--json number \
				--jq 'length > 0' | \
				grep -q true; \
			then \
				echo \"$branch\"; \
			fi; \
		done; \
	}; f"

	delete-merged-branches = "!f() { \
		git fetch --prune && \
		git merged-branches | \
		while IFS= read -r branch; do \
			echo \"Deleting: $branch\"; \
			git branch -D \"$branch\"; \
		done; \
	}; f"
[include]
	path = ~/.gitconfig.local

#
## .gitcongig.local
#
# [user]
# 	signingkey = XXXXXXXXXXXXXXXX
# [commit]
# 	gpgsign = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
